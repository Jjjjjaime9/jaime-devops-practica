# Plantilla de configuración de nginx. Al arrancar el contenedor, la imagen oficial
# sustituye ${API_URL} por el valor de la variable de entorno y genera
# /etc/nginx/conf.d/default.conf.
server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Fotos de hasta 5 MB (POST /imagenes)
    client_max_body_size 6m;

    # Frontend estático
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy inverso a la API: /api/productos -> ${API_URL}/productos
    location /api/ {
        proxy_pass         ${API_URL}/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Swagger (/api/docs) pide el esquema en la ruta absoluta /openapi.json
    location = /openapi.json {
        proxy_pass ${API_URL}/openapi.json;
    }
}
